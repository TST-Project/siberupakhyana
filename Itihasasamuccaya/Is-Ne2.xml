  <text corresp="#Is-Ne2" xml:lang="sa">
    <body>
      <pb n="15r" facs="34"/>
      <lb n="1"/>
      <p xml:id="Is4-p1">vaiśaṃpāyana uvāca ||</p>
      <lg xml:id="Is4.1">
        <l>kathayantaṃ hi tīrthānāṃ prabhāvānadbhutāṃs tathā || </l>
        <l>romasaṃ dharmatatva<gap reason="lost"/></l>
      </lg>
      <p xml:id="Is4-p2"><lb n="2"/>yudhiṣṭhira uvāca ||</p>
      <lg xml:id="Is4.2">
        <l>yo rakṣet prāṇinaṃ brahman_ bhayārttaṃ <unclear>sa</unclear>raṇāgataṃ |</l>
        <l>tasya puṇyaphalaṃ yat syāt tan me brūhi tapodhana |</l>
      </lg>
      <lg xml:id="Is4.3" corresp="#VP65.27 #Mbh131.5ter">
        <l><gap reason="lost"/><lb n="3"/>vaḥ sarvvasamagravaradakṣiṇāḥ |</l>
        <l>ekato bhayabhītasya prāṇinaḥ prāṇarakṣaṇaṃ ||</l>
      </lg>
      <lg xml:id="Is4.4">
        <l>idam eva purā devās tulayā<gap reason="lost"/></l>
        <l><gap reason="lost"/><lb n="3"/>veha gaurave<sic>nā</sic>tiricyate ||</l>
      </lg>
      <lg xml:id="Is4.5">
        <l>atraivodāharantīmam itihāsa purātanaṃ |</l>
        <l>indrasyāgneś ca saṃvādaṃ śiber ā<gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.6" corresp="#Mbh130.19">
        <l><gap reason="lost"/><lb n="4"/>yajñe jijñāsārthaṃ śiviṃ nṛpa |</l>
        <l>indraḥ syenaḥ kapoto 'gnir bhūtvā tatropajagmatuḥ ||</l>
      </lg>
      <lg xml:id="Is4.7" corresp="#VP65.3 #Mbh130.20">
        <l>athoruṃ nṛpateḥ <gap reason="lost"/></l>
        <l><gap reason="lost"/><lb n="5"/><unclear>nā</unclear>rthī mahīpālaṃ nililye bhayavihvalaḥ ||</l>
      </lg>
      <lg xml:id="Is4.8">
        <l>tataḥ śanair upāgamya syenarūpī sureśvaraḥ |</l>
        <l>rājānaṃ sumahā<gap reason="lost"/></l>
       </lg>
      <p><gap reason="lost"/><pb n="15v"/><lb n="1"/>ca ||</p>
      <lg xml:id="Is4.9ab" corresp="#VP65.6ab #Mbh131.1ab">
        <l>dharmātmānaṃ cāhur ekaṃ sarvvarājan mahīkṣitaḥ |</l>
      </lg>
      <lg xml:id="Is4.9cd" corresp="#VP65.6cd #Mbh131.1cd">
         <l>sa tvaṃ dharmaviruddhaṃ hi katham etat kariṣyasi ||</l>
      </lg>
      <lg xml:id="Is4.10" corresp="#VP65.7">
        <l>bhavān kṛtaghnaṃ dā<gap reason="lost"/></l>
        <l><gap reason="lost"/><lb n="2"/>rmāṇam asādhuṃ sādhunā jayet ||</l>
      </lg>
      <lg xml:id="Is4.11" corresp="#VP65.10">
        <l>nopakārāpare py evam apakāraparo janaḥ |</l>
        <l>apakāre pare pi tva<gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.12">
        <l><gap reason="lost"/><lb n="3"/>s tvaṃ pāpe pi tvam apāpakṛt |</l>
        <l>doṣānveṣaṇadakṣe pi guṇānveṣaṇatatparaḥ ||</l>
      </lg>
      <lg xml:id="Is4.13">
        <l>tad eṣa vihito bhakṣaḥ pīḍyamāna<gap reason="lost"/></l>
        <l><gap reason="lost"/><lb n="4"/>dharmam utsṛṣṭavān asi ||</l>
      </lg>
      <p xml:id="Is4-p5">rājovāca ||</p>
      <lg xml:id="Is4.14">
        <l>saṃtrastarūpas trāṇārthī tvatto bhīto vihaṃgamaḥ |</l>
        <l>matsakāsam anuprā<gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.15ab">
        <l><gap reason="lost"/><lb n="5"/>vam āgatasyāsya kapotasya bhayārthinaḥ |</l>
        </lg>
      <lg xml:id="Is4.15cd">
        <l>katham asmadvidhāḥ kuryat tyāgaṃ sadbhir vigarhita ||</l>
      </lg>
      <lg xml:id="Is4.16" corresp="#VP65.13">
        <l>lobhād veṣā<gap reason="lost"/> <lb n="6"/>|</l>
        <l>brahmahatyāsaman tasya pāpam āhur manīṣiṇaḥ ||</l>
      </lg>
      <lg xml:id="Is4.17" corresp="#VP65.14">
        <l>śāstreṣu niṣkṛtir dṛṣṭā mahāpātakinām api |</l>
        <l>śaraṇāgatahantus tu <gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.18" corresp="#VP65.15">
        <l><pb n="16r" facs="39"/><lb n="1"/>yathātmanaḥ priyāḥ prāṇāḥ sarvveṣāṃ prāṇināṃ tathā |</l>
        <l>tasmān mṛtyubhayatrastās trātavyāḥ prāṇino budhaiḥ ||</l>
      </lg>
      <lg xml:id="Is4.19" corresp="#VP65.16">
        <l>janmamṛtyujarāduḥkhair ni<gap reason="lost"/></l>
        <l><gap reason="lost"/><lb n="2"/>parikliśyante mṛtyos trasyanti te tataḥ ||</l>
      </lg>
      <lg xml:id="Is4.20" corresp="#VP65.17">
        <l>yannimittaṃ bhavec chokas trāso vā krodha eva vā |</l>
        <l>āyāso vā yato mūlam ekāham a<gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.21" corresp="#VP65.18">
        <l><gap reason="lost"/><lb n="3"/>yad duḥkhaṃ puruṣasyopajāyate |</l>
        <l>yuktan tenānumānena paro¦ pi parirakṣituṃ ||</l>
      </lg>
      <lg xml:id="Is4.22" corresp="#VP65.19">
        <l>yathā hi te jīvitam ātmanaḥ priyaṃ ta<gap reason="lost"/> |</l>
        <l><lb n="4"/>saṃrakṣase jīvitam ātmano yathā tathā pareṣām api rakṣa jīvitaṃ ||</l>
      </lg>
      <lg xml:id="Is4.23" corresp="#VP65.20">
        <l>tasmān nāham imaṃ bhītam arpayiṣye kapotakaṃ <gap reason="lost"/></l>
        <l><gap reason="lost"/><lb n="5"/>nāśu tad vada ||</l>
      </lg>
      <p xml:id="Is4-p6">syena uvāca ||</p>
      <lg xml:id="Is4.24" corresp="#VP65.21">
        <l>āhārāt sarvvabhūtāni saṃ¦bhavanti janeśvara |</l>
        <l>āhāreṇa vivarddhante tena jīvanti <gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.25ab">
        <l><gap reason="lost"/><lb n="6"/>rthe rājan varttayituṃ ciraṃ |</l>
      </lg>
      <lg xml:id="Is4.25gh" corresp="#Mbh131.7cd #VP65.22cd">
        <l>na tv āhāravihīnena śakyaṃ varttayituṃ kvacit ||</l>
      </lg>
      <lg xml:id="Is4.26" corresp="#VP65.23">
        <l>bhakṣād vilopitasyāmān mama prāṇā viśāṃpa<gap reason="lost"/></l>
        <l><gap reason="lost"/><pb n="16v" facs="38"/><lb n="1"/>nthānam apunarbhavaṃ ||</l>
      </lg>
      <lg xml:id="Is4.27" corresp="#VP65.24">
        <l>mṛte ca mayi sarvvaṃ me putradāraṃ mariṣyati |</l>
        <l>rakṣamāṇaḥ kapotaṃ tvaṃ bahūn prāṇān na rakṣasi ||</l>
      </lg>
      <lg xml:id="Is4.28" corresp="#VP65.25">
        <l>dharmaṃ yo bādhate dha<gap reason="lost"/></l>
        <l><gap reason="lost"/><lb n="2"/>tu yo dharmaḥ sa dharmaḥ sadbhir ucyate ||</l>
      </lg>
      <lg xml:id="Is4.29ab" corresp="#VP65.26ab #Mbh131.11ab">
       <l>tasmād virodhe dharmasya vicintya gurulāghavaṃ |</l>
      </lg>
      <lg xml:id="IS4.29cd" corresp="#VP65.26cd #Mbh131.12cd">
       <l>yataḥ śreyas tato rājan kuru <gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.30" corresp="#VP65.28">
        <l><lb n="3"/>nāsmād bhūyataro dharmaḥ kaścid anyo sti khecara |</l>
        <l>prāṇināṃ bhayabhītānām abhayaṃ yat pradīyate ||</l>
      </lg>
      <lg xml:id="Is4.31" corresp="#VP65.29">
        <l>varam ekasya satva<gap reason="lost"/></l>
        <l><gap reason="lost"/><lb n="4"/>tu viprasahasrasya gosahasram alaṃkṛtam ||</l>
      </lg>
      <lg xml:id="Is4.32" corresp="#VP65.32">
        <l>abhayaṃ sarvvabhūtebhyo yo dadāti dayāparaḥ |</l>
        <l>tasya dehād vimuktasya na bha<gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.33" corresp="#VP65.30">
        <l><gap reason="lost"/><lb n="5"/>nudharādīnāṃ dātāraḥ sulabhā bhuvi |</l>
        <l>durllabhaḥ puruṣo loke sarvvabhūtābhayapradaḥ ||</l>
      </lg>
      <lg xml:id="Is4.34" corresp="#VP65.31">
        <l>mahatām api yajñānāṃ kālena kṣīyate <gap reason="lost"/></l>
        <l><gap reason="lost"/><lb n="6"/>sya kṣaya eva na vidyate ||</l>
      </lg>
      <lg xml:id="Is4.35" corresp="#VP65.33">
        <l>dattam iṣṭaṃ tapas taptaṃ tīrthasevā śrutan tathā |</l>
        <l>sarvvāny abhayadānasya kalāṃ nārhanti ṣoḍaśīṃ ||</l>
      </lg>
      <lg xml:id="Is4.36" corresp="#VP65.34">
        <l>catuḥsa<gap reason="lost"/><pb n="17r" facs="38"/><lb n="1"/>t pṛthivīm imāṃ ||</l>
        <l>abhayaṃ yaś ca bhūtebhyas tayor abhayado 'dhikaḥ ||</l>
      </lg>
      <lg xml:id="Is4.37" corresp="#VP65.35">
        <l>api tyaje rājyam ahaṃ śarīraṃ vā sudustyajaṃ |</l>
        <l>na tv imaṃ bhayasaṃtrastaṃ tyakṣed dī<gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.38" corresp="#VP65.36">
        <l><gap reason="lost"/><lb n="2"/>śubhaṃ kiñcit tena janmani janmani |</l>
        <l>bhaveyam aham ārttānām prāṇinām ārttināśānaḥ ||</l>
      </lg>
      <lg xml:id="Is4.39" corresp="#VP65.37">
        <l>na hy ahaṅ kāmaye rājyaṃ na svarggaṃ nā<gap reason="lost"/></l>
        <l><gap reason="lost"/><lb n="2"/>taptānāṃ kāmaye duḥkhanāśanaṃ ||</l>
      </lg>
      <lg xml:id="Is4.40" corresp="#VP65.38">
        <l>yathā ca nānṛtā vāṇī mayaiṣā samudāhṛtā |</l>
        <l>satyenānena bhagavān prasīdatu ma<gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.41" corresp="#VP65.39">
        <l><gap reason="lost"/><lb n="4"/>māraṃbhas tava cāyaṃ vihaṅgama |</l>
        <l>tad yathaiṣṭan tavāhāram anyad eva dadāmy ahaṃ ||</l>
      </lg>
      <p xml:id="Is4-p8">syena uvāca ||</p>
      <lg xml:id="Is4.42">
        <l>ya eva vihito 'smā<gap reason="lost"/></l>
        <l><lb n="5"/>tam utsṛjya na cāhāraiḥ kāryam asty aparair mama ||</l>
      </lg>
      <lg xml:id="Is4.43" corresp="#VP65.41">
        <l>syenāḥ kapotān_ khādanti śrutir e<unclear>khā</unclear> sanātanī |</l>
        <l>mā rājan sā<gap reason="lost"/><lb n="6"/>ruha ||</l>
      </lg>
      <p xml:id="Is4-p9">rājovāca ||</p>
      <lg xml:id="Is4.44" corresp="#VP65.42">
        <l>nāhaṃ kuśāstramārggeṇa kvacid vartte vihaṃgama |</l>
        <l>śāstre <unclear>cai</unclear>vopadiṣṭo 'yaṃ dharmaḥ satvadayāparaḥ ||</l>
      </lg>
      <lg xml:id="Is4.45" corresp="#VP65.43">
        <l>sarvva<gap reason="lost"/><pb n="17v"/><lb n="1"/>dayā ||</l>
        <l>sarvasatvapradānāc ca dayaikāsmin viśiṣyate ||</l>
      </lg>
      <lg xml:id="Is4.46" corresp="#VP65.44">
        <l>sarvve vedā na tat kuryuḥ sarvve yajñāś ca khecara |</l>
        <l>sarvvatīrthābhiṣekaś ca yat kuryā<gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.47" corresp="#VP65.45">
        <l><gap reason="lost"/><lb n="2"/>ye tu sarvvabhūtahite ratāḥ |</l>
        <l>dayādarśitapānthāno brahmalokaṃ vrajanti te ||</l>
      </lg>
      <lg xml:id="Is4.48" corresp="#VP65.46">
        <l>gacchatas tiṣṭhato vāpi jāgrataḥ svapato pi <gap reason="lost"/></l>
        <l><gap reason="lost"/><lb n="3"/>śor iva ceṣṭitaṃ ||</l>
      </lg>
      <lg xml:id="Is4.49" corresp="#VP65.47">
       <l>jaṅgamāni ca bhūtāni sthāvarāṇi ca ye narāḥ |</l>
        <l>ātmavat parirakṣanti te yānti paramāṃ gati<gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.50" corresp="#VP65.48">
        <l><gap reason="lost"/><lb n="4"/>śatruḥ samupekṣate |</l>
        <l>sa yāti narakaṃ ghoram iti prāhur maharṣayaḥ ||</l>
      </lg>
      <lg xml:id="Is4.51" corresp="#VP65.49">
        <l>rājyaṃ śivir ahaṃ samyak_ prayacchāmi tava dvi<unclear>ja</unclear><gap reason="lost"/></l>
        <l><gap reason="lost"/>varjayitvā kapotakaṃ ||</l>
      </lg>
      <p xml:id="Is4-p10">syena uvāca ||</p>
      <lg xml:id="Is4.52" corresp="#VP65.50">
        <l>yadi rājan kapote te sudṛḍhā prītir īdṛśī |</l>
        <l>tataḥ kapotatulyāni <gap reason="lost"/></l>
      </lg>
      <p xml:id="Is4-p11"><gap reason="lost"/><lb n="6"/>jovāca ||</p>
      <lg xml:id="Is4.53" corresp="#VP65.51">
        <l>anugraham idaṃ manye yan māṃsenābhibhāṣase |</l>
        <l>etat te haṃ prayacchāmi svamāṃsaṃ yāvad icchasi ||</l>
      </lg>
      <lg xml:id="Is4.54">
        <l>yad apriyaṃ tat sva<gap reason="lost"/><pb n="18r" facs="39"/><lb n="1"/>vā |</l>
        <l>mama tu priyam evetat kasmād abhihitaṃ cirāt |</l>
      </lg>
      <lg xml:id="Is4.55" corresp="#VP65.53">
        <l>adhruveṇa śarīreṇa pratikṣaṇavināśinā |</l>
        <l>dhruvaṃ yo nārjayed dharmaṃ sa śocyo <gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.56" corresp="#VP65.54">
        <l><gap reason="lost"/><lb n="2"/>ṇyupakārāya deho 'yaṃ nopayujyate |</l>
       <l>tataḥ kim upakāro 'sya pratyahaṃ kriyate vṛthā ||</l>
      </lg>
      <p xml:id="Is4-p12">syena uvāca ||</p>
      <lg xml:id="Is4.57">
        <l>nātirikta<gap reason="lost"/> <lb n="3"/>janeśvara |</l>
        <l>tasmāt kapotena samaṃ prayaccha tulayā bhṛ¦śaṃ ||</l>
      </lg>
      <p xml:id="Is4-p13">rājovāca ||</p>
      <lg xml:id="Is4.58">
        <l>tad evāhaṃ kariṣyāmi yan māṃ senābhi<gap reason="lost"/></l>
        <l><gap reason="lost"/><lb n="4"/>śaṃ me syāt tat kariṣye vihaṅgama ||</l>
      </lg>
      <p xml:id="Is4-p14">lomasa uvāca ||</p>
      <lg xml:id="Is4.59" corresp="#VP65.55">
        <l>evam uktvā svamāṃsāni tam utkṛtya sa pārthivaḥ |</l>
        <l>prahṛṣṭa<gap reason="lost"/><lb n="5"/>na saha prabhuḥ ||</l>
      </lg>
      <lg xml:id="Is4.60" corresp="#VP65.56">
        <l>tyaktvātmasukhabhogecchāṃ sarvvasattvasu¦khaiṣiṇaḥ |</l>
        <l>bhavanti paraduḥkhena sādhavo nityadukhi<gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.61" corresp="#VP65.57">
        <l><gap reason="lost"/><lb n="6"/>yā kapoto vyatiricyate |</l>
        <l>punaś cotkṛtya māṃsāni tataḥ prādāt sa cārthivaḥ ||</l>
      </lg>
      <lg xml:id="Is4.62" corresp="#VP65.58">
        <l>na vidyate yadā māṃsaṃ kapotena samaṃ kva<gap reason="lost"/></l>
        <l><gap reason="lost"/><pb n="18v"/><lb n="1"/>tau cāruroha tulāṃ svayaṃ ||</l>
      </lg>
      <lg xml:id="Is4.63" corresp="#VP65.60">
       <l>paraduḥkhāturā nityaṃ sarvvabhūtahite ratāḥ |</l>
        <l>nāpekṣante mahānmānaḥ svasukhāni mahāṃty api ||</l>
      </lg>
      <lg xml:id="Is4.64" corresp="#VP65.64">
        <l>atha ta<gap reason="lost"/><lb n="2"/>pe |</l>
        <l>devaduṃdubhayo neduḥ puṣpavṛṣṭiḥ papāta ca ||</l>
      </lg>
      <lg xml:id="Is4.65" corresp="#VP65.65">
        <l>tatas tasya tadā matvā dharmarājño dhṛtiṃ parāṃ |</l>
        <l>śākraḥ svarūpam āsthāya vā<gap reason="lost"/></l>
      </lg>
      <p xml:id="Is4-p15"><gap reason="lost"/><lb n="3"/>||</p>
      <lg xml:id="Is4.66" corresp="#VP65.66">
       <l>indro ham asmi bhadran te kapoto havyavāhanaḥ |</l>
       <l>jijñāsa¦mānau tvāṃ rājann imaṃ yajñam upāgatau ||</l>
      </lg>
      <lg xml:id="Is4.67ab" corresp="#VP65.67cd">
        <l>naitat pūrvvaṃ nṛpāś cakrur na <gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.67cd" corresp="#VP65.67ab">
        <l><gap reason="lost"/><lb n="4"/>ruṇikeneha yat kṛtaṃ duṣkaraṃ tvayā ||</l>
      </lg>
      <lg xml:id="Is4.68" corresp="#VP65.68">
        <l>parārthe tyajataḥ prā¦ṇānyā prītir abhavat tava |</l>
        <l>prāṇasaṃśayalubdheṣu na prāṇiṣu ca<gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.69" corresp="#VP65.69">
        <l><gap reason="lost"/><lb n="5"/>lyāṇī sva<unclear>śre</unclear>yo 'tyantaniṣṭhurā |</l>
        <l>tvayy eva kevalaṃ rājan_ karuṇā karuṇāyate ||</l>
      </lg>
      <lg xml:id="Is4.70" corresp="#VP65.70">
        <l>svakarmapāśaiḥ sudṛḍhair baddhaṃ kṛtsnam i<gap reason="lost"/></l>
        <l><gap reason="lost"/><lb n="6"/>kṣārthaṃ baddhaḥ karuṇayā nṛpa ||</l>
      </lg>
      <lg xml:id="Is4.71ab">
        <l>tathā sarvvātmanā cāpi doṣeṣu pra<unclear>kṛ</unclear>taṃ tvayā |</l>
      </lg>
      <lg xml:id="Is4.71cd">
        <l>yathā caivātmanaḥ sthāne vāsanāpi na vidyate ||</l>
      </lg>
      <lg xml:id="Is4.72" corresp="#VP65.73">
        <l>a<gap reason="lost"/><pb n="19r" facs="20"/>nānavamanya ca |</l>
        <l>akṛtvā sadṛ<unclear>śe</unclear> sparddhāṃ tvaṃ lokottamatāṃ gataḥ ||</l>
      </lg>
      <lg xml:id="Is4.73">
        <l>paropakārajanmāno vidhātrā vihitās trayaḥ |</l>
        <l>sajalā jaladās tv e<gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.74" corresp="#VP65.74">
        <l><lb n="2"/>ātmaprāṇaiḥ paraprāṇānyo naraḥ parirakṣati |</l>
        <l>sa yāti tatparaṃ dhāmaṃ yato nāvarttate punaḥ ||</l>
      </lg>
      <lg xml:id="Is4.75ab" corresp="#VP65.75ab">
        <l>prāṇair api tvayā rājan rakṣi<gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.75cd" corresp="#VP65.75cd">
        <l><gap reason="lost"/><lb n="3"/>māṃsāny api dattāni dravyeṣv anyeṣu kā kathā ||</l>
      </lg>
      <lg xml:id="Is4.76" corresp="#VP65.76">
        <l>paśavo pi hi¦ jīvanti kevalātmodaraṃbharāḥ |</l>
        <l>sa punar jīvati ślāghyo yaḥ pa<gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.77" corresp="#VP65.77">
        <l><gap reason="lost"/><lb n="4"/>tra citraṃ yat santaḥ parānugrahatatparāḥ |</l>
        <l>na hi svadehasītāya jāyate candanadrumaḥ ||</l>
      </lg>
      <lg xml:id="Is4.78" corresp="#VP65.78">
        <l>paropakāravyāpāraparo yaḥ <gap reason="lost"/></l>
        <l><gap reason="lost"/><lb n="5"/>d avāpnoti parād api hi tat paraṃ ||</l>
      </lg>
      <lg xml:id="Is4.79" corresp="#VP65.79">
        <l>paropakārekadhiyaḥ¦ svasukhāya gataspṛhāḥ |</l>
        <l>jagaddhitāya jāyante sādhavas tv ā<gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.80" corresp="#VP65.80">
        <l><gap reason="lost"/><lb n="6"/>ni gātrebhyaḥ samutkṛttāni pārthiva |</l>
       <l>eṣā te sāsvatī kīrtir lokān anugāmiṣyati ||</l>
      </lg>
      <lg xml:id="Is4.81" corresp="#VP65.81">
        <l>divyarūpadharaś caiva pālayitvā <gap reason="lost"/></l>
        <l><gap reason="lost"/><pb n="19v" facs="19"/><lb n="1"/>kramya brahmalokaṃ gamiṣyasi ||</l>
      </lg>
      <p xml:id="Is4-p16">lomasa uvāca ||</p>
      <lg xml:id="Is4.82" corresp="#VP65.82">
        <l>evam uktvā tam indrāgnī jagmatus tridaśālayaṃ |</l>
        <l>rājāpi kratum iṣṭvā tu sumu<gap reason="lost"/></l>
      </lg>
      <lg xml:id="Is4.83" corresp="#VP65.83">
        <l><gap reason="lost"/><lb n="2"/>tyaṃ śiveś caritam uttamaṃ |</l>
       <l>sa vidhūyeha pāpāni prayāti paramaṃ padaṃ ||</l>
      </lg>
      <lg xml:id="Is4.84">
        <l>vicintya rājā svasarīram adhruvaṃ dhruvaṃ yaśaḥ sa<gap reason="lost"/></l>
        <l><gap reason="lost"/><lb n="3"/>śarīradānāt parajīvarakṣaṇaṃ vidhāya lokatrayabhūṣaṇaṃ yayau ||</l>
      </lg>
      <p xml:id="Is4-p17">|| ❈ || itihāsasamuccaye syenakapotīya nāma ca<gap reason="lost"/></p>
</body></text></TEI>
