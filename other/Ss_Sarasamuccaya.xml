<text corresp="#Ss" xml:lang="sa"><body>
  <pb n="120" facs="73"/>
  <lg corresp="#Is4.50">
      <l><lb n="1"/>gacchatas tiṣṭhato vāpi jāgrataḥ svapato 'pi na |</l>
      <l><lb n="2"/>phalaṃ bhutahitārthāya tat_ paśor iva ceṣṭitam || 145 ||</l>
  </lg>
  <pb n="123" facs="74"/>
  <lg corresp="#VP65.32">
    <l><lb n="7"/>abhayaṃ sarvvabhūtebhyo yo dadāti dayāparaḥ |</l>
      <l><lb n="8"/>abhayaṃ <app><lem>tasya </lem><rdg wit="#s">sarva</rdg></app>bhūtāni <app><lem>dadatīha na </lem><rdg wit="#a">dadatīty anu</rdg></app>saṃśaya || 150 ||</l>
  </lg>
  <pb n="124" facs="75"/>
  <lg corresp="#VP65.43">
    <l><lb n="6"/>sarvvasattveṣu yad dānam ekasattve ca yā dayā</l>
    <l><lb n="7"/>sarvvasattvapradānād dhi dayaikā ca viśiṣyate || 151 ||</l>
  </lg>
