      <p>
        <milestone unit="page" n="2866" facs="51"/>
        <cb n="3"/>
        <lb n="8"/>bhayabhītaḥ tri trāsenātaṅkitaḥ | <lb n="9"/>yathā |
      </p>
      <lg corresp="#VP65.27 #Is4.3">
        <l>ekato bhayabhītasya prāṇinaḥ <lb n="10"/>prāṇarakṣaṇaṃ |</l>
      </lg>
      <lg corresp="#VP65.28">
        <l>nāto gurutaro dharmmaḥ <lb n="11"/>kaścid anyo 'sti khecara ||</l>
      </lg>
      <p> iti vahni<lb n="12"/>purāṇe śivirājopājkhyānaṃ ||</p>
