<text corresp="#Nsp" xml:lang="sa"><body>
  <pb n="212" facs="214"/>
  <lg corresp="#VP65.14">
    <l><lb n="15"/>śāstreṣu niḥkṛtir dṛṣṭā mahāpātakinām api |</l>
    <l><lb n="16"/>kṛtaghnasya kape duṣṭa na dṛṣṭā niḥkṛtiḥ purā || 51 ||</l>
  </lg>
  <lg>
    <l><lb n="17"/>kṛtaghnatā na kāryā te tvatkṛtaṃ samayaṃ smara |</l>
    <l><lb n="18"/>ehy ehy āgacca śaraṇaṃ kākutsthaṃ hitapālakam || 52 ||</l>
  </lg>
</body></text></TEI>