<text corresp="#Svr" xml:lang="pra"><body xml:lang="sa">
  <pb facs="414" n="372v"/>
  <lg>
    <l><lb n="5"/>“yo dadāti sahasrāṇi, gavām a'śvaśatāni ca |</l>
    <l>abhayaṃ sarvasttvebhya―s tad danam a'tiricyate || 4783 ||</l>
  </lg>
  <lg>
    <l><lb n="7"/>samagrāvayavān_ dṛṣṭ_vā, narān prāṇivadhodyatān |</l>
    <l>paṃgubhyaś chinnahastebhyaḥ, kuṣṭhibhyaḥ spṛhayāmy ahaṃ || 4784 ||</l>
  </lg>
   <lg>
    <l><lb n="8"/>kapilānāṃ sahasraṃ tu, yo dvijebhyaḥ prayacchati |</l>
    <l> ekasya jīvitaṃ dadyāt, kalāṃ nā'arhati ṣoḍaśīṃ || 4785 ||</l>
  </lg>
  <lg corresp="#VP65.28">
    <l><lb n="9"/>nā'to bhūyastamo dharmaḥ, kaścid a'nyo 'sti bhūtale |</l>
    <l>prāṇināṃ bhayabhītānāṃ, abhayaṃ yat pradīyate || 4786 ||</l>
  </lg>
  <lg corresp="#VP65.29">
    <l><lb n="10"/>varam ekasya sattvasya, dattā hy abhayadakṣiṇā |</l>
    <l>na tu viprasahasrebhyo, gosahasram a'laṃkṛtaṃ || 4787 ||</l>
  </lg>
  <lg corresp="#VP65.32">
    <l><lb n="11"/>abhayaṃ sarvasattvebhyo, yo dadāti dayāparaḥ |</l>
    <l>tasya dehād vimuk_tasya, bhayaṃ nā'sti kutaścana || 4788 ||</l>
  </lg>
  <lg corresp="#VP65.30">
    <l><lb n="12"/>hemadhenudharā''dīnāṃ, dātāraḥ sulabhā bhuvi |</l>
    <l>durlabhaḥ puruṣo loke, yaḥ prāṇiṣv abhayapradaḥ || 4789 ||</l>
  </lg>
  <lg corresp="#VP65.31">
    <l><lb n="13"/>mahatām a'pi dānānāṃ, kālena kṣiyate phalaṃ |</l>
    <l>bhītā'bhayapradānasya, kṣaya eva na vidyate || 4790 ||</l>
  </lg>
  <lg corresp="#VP65.33">
    <l><lb n="14"/>dattam iṣṭaṃ tapas taptaṃ, tīrthasevā tathā śrutaṃ |</l>
    <l>sarvāṇy abhayadānasya, kalāṃ nā'rhanti ṣoḍaśīṃ || 4791 ||</l>
  </lg>
  <lg corresp="#VP65.15">
    <l><lb n="15"/>yathā me na priyā mṛtyuḥ, sarveṣāṃ praṇanāṃ tathā |</l>
    <l>tasmān mṛtyubhayatrastā―s trātavyāḥ prāṇino budhaiḥ” || 4792 ||</l>
  </lg>
  <lg corresp="#VP65.27 #Is4.3">
    <l><pb n="373r" facs="415"/><lb n="1"/>“ekatra kratavaḥ sarve, samagravaradakṣiṇāḥ |</l>
    <l>ekato bhayabhītasya, prāṇinaḥ prāṇarakṣaṇaṃ || 4793 ||</l>
  </lg>
  <lg corresp="#VP65.43">
    <l><lb n="2"/>sarvasattveṣu yad dānaṃ, ekasattve ca yā dayā |</l>
    <l>sarvasattvapradānād dhi, dayaivekā praśasyate || 4794 ||</l>
  </lg>
  <lg corresp="#VP65.44">
    <l><lb n="3"/>sarve vedā na tat_ kuryuḥ, sarvve yajñā yathoditāḥ |</l>
    <l>sarvatīrthābhiṣekāś ca, yat_ kuryāt_ prāṇināṃ dayā” || 4795 ||</l>
  </lg>
</body></text></TEI>
