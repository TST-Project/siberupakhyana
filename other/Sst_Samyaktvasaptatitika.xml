<text corresp="#Ssṭ" xml:lang="sa"><body>
  <pb facs="396" n="185v"/>
  <lg>
    <l><lb n="11"/>yathā merur nagendrāṇāṃ, marutāṃ vāsavo yathā |</l>
    <l>tathaiva sarvadharmmāṇāṃ, pradhānaṃ <lb n="12"/>jīvarakṣaṇam || 1 ||</l>
  </lg>
  <lg corresp="#VP65.30 #Is4.33">
    <l>hemadhenudharādīnāṃ, dātāraḥ sulabha bhuvi |</l>
    <l>durlabhaḥ sa pumām̐lloke, yaḥ prāṇiṣv abhayapradaḥ || 2 ||</l>
  </lg>
  <lg corresp="#VP65.31 #Is4.34">
    <l><lb n="13"/>mahatām api danānāṃ, kālena kṣīyate phalam |</l>
    <l>bhītābhayapradānasya, kṣaya eva na vidyate || 3 ||</l>
  </lg>
</body></text></TEI>
