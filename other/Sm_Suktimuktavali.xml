<text corresp="#Sm" xml:lang="sa"><body>
  <pb n="446" facs="512"/>
  <lg>
    <l><lb n="18"/>na satyavacanaṃ satyaṃ nāsatyavacanaṃ mṛṣā |</l>
    <l><lb n="19"/>yad bhūtahitam atyantaṃ tat satyam itaran mṛṣā || 7 ||</l>
  </lg>
  <lg corresp="#VP65.43 #Is4.45">
    <l><lb n="20"/>sarvasattveṣu yad dānam ekā sattveṣu yā dayā |</l>
    <l><lb n="21"/>sarvasattvapradānād dhi yad ekā 'pi viśiṣyate || 8 ||</l>
  </lg>
