<text corresp="#Spr" xml:lang="sa"><body>
  <pb facs="59" n="22"/>
  <head><lb n="7"/>abhayadāna (3)</head>
  <lg>
    <l><lb n="8"/>māryamāṇasya hemādri, rājyaṃ vā 'tha prayacchatu |</l>
    <l><lb n="9"/>tad aniṣṭaṃ parityajya, jīvo jīvitum icchati || 1 ||</l>
  </lg>
  <p><lb n="10"/>yoga śāstra (pra॰ sabhā) prṣṭha 71</p>
  <lg corresp="#VP65.30 #Is4.33">
    <l><lb n="15"/>hema-dhenu-dharādīnāṃ, dātāraḥ sulabhā bhuvi |</l>
    <l><lb n="16"/>durlabhaḥ puruṣo loke, yaḥ prāṇiṣv abhayapradaḥ || 2 ||</l>
  </lg>
  <p><lb n="17"/>mārkaṇḍa purāṇa, skandha 2, a॰ 7, śloka 13.</p>
  <pb facs="60" n="23"/>
  <lg corresp="#VP65.29 #Is4.31">
    <l><lb n="3"/>varam ekasya sattvasya, dattā hy abhayadakṣiṇā |</l>
    <l><lb n="4"/>na tu viprasahasrebhyo, gosahasram alaṅkṛtam || 3 ||</l>
  </lg>
  <p><lb n="5"/>mārkaṇḍa purāṇa, skandha 2, a॰ 7, śloka 91.</p>
  <lg>
    <l><lb n="10"/>kapilānāṃ sahasrāṇi, yo viprobhyaḥ prayacchati |</l>
    <l><lb n="11"/>ekasya jīvitaṃ dadyān na ca tulyaṃ yudhiṣṭhira! || 4 ||</l>
  </lg>
  <p><lb n="12"/>mārkaṇḍa purāṇa, skandha 6, a॰ 13, śloka 52.</p>
  <lg>
    <l><lb n="16"/>jīvānāṃ rakṣaṇaṃ śreṣṭhaṃ, jīvā jīvitakāṅkṣiṇaḥ |</l>
    <l><lb n="17"/>tasmāt samastadānebhyo 'bhayadanaṃ praśasyate || 5 ||</l>
  </lg>
  <p><lb n="18"/>mārkaṇḍa purāṇa, skandha 8, a॰ 11, śloka 33.</p>
  <pb facs="61" n="24"/>
  <lg>
    <l><lb n="3"/>yo dadyāt_ kāñcanaṃ meruṃ, kṛtsnāṃ caiva vasudharām |</l>
    <l><lb n="4"/>ekasya jīvitaṃ dadyān na ca tulyaṃ yudhiṣṭhira! || 6 ||</l>
  </lg>
  <p><lb n="5"/>mārkaṇḍa purāṇa, skaṃdha 8, a॰ 11, śloka 53.</p>
  <lg>
    <l><lb n="11"/>yo dadāti sahasrāṇi, gavām aśvaśatāni ca |</l>
    <l><lb n="12"/>abhayaṃ sarvasattvebhyas tad dānam atiricyate || 7 ||</l>
  </lg>
  <p><lb n="13"/>mahā bhārata, śānti parva, a॰ 304, śloka 5.</p>
  <lg corresp="#VP65.33 #Is4.35">
    <l><lb n="17"/>dattam iṣṭaṃ tapas taptaṃ, tīrthasevā tathā śrutam |</l>
    <l><lb n="18"/>sarve 'py abhayadānasya, kalāṃ nārhanti ṣoḍaśīm || 8 ||</l>
  </lg>
  <p><lb n="19"/>mārkaṇḍa purāṇa, a॰ 4, śloka 19.</p>
  <pb facs="62" n="25"/>
<lg corresp="#VP65.28 #Is4.30">
  <l><lb n="5"/>nāto bhūyas tapodharmaḥ, kaścid anyo 'sti bhūtale |</l>
  <l><lb n="6"/>prāṇināṃ bhayabhītānām abhayaṃ yat_ pradīyate || 9 ||</l>
  </lg>
  <p><lb n="7"/>mārkaṇḍa purāṇa, a॰ 11, śloka 5.</p>
  <lg corresp="#VP65.31 #Is4.34">
    <l><lb n="10"/>mahatām api dānānāṃ, kālena kṣiyate phalam |</l>
    <l><lb n="11"/>bhītābhayapradānasya, kṣaya eva na vidyate || 10 ||</l>
  </lg>
  <p><lb n="12"/>mārkaṇḍa purāṇa, a॰ 13, śloka 26.</p>
  <lg corresp="#VP65.27 #Is4.3">
    <l><lb n="16"/>ekataḥ kāñcano merur bahuratnā vasuṃdharā |</l>
    <l><lb n="17"/>ekato bhayabhītasya, prāṇinaḥ prāṇarakṣaṇam || 11 ||</l>
  </lg>
  <p><lb n="18"/>dāna candrikā, śloka 81.</p>
  <pb facs="63" n="26"/>
  <lg>
    <l><lb n="4"/>yo bhūteṣv abhayaṃ dadyād, bhūtebhyas tasya no bhayam |</l>
    <l><lb n="5"/>yādṛg_ vitīryate danaṃ, tādṛg āsādyate phalam || 12 ||</l>
  </lg>
  <p><lb n="6"/>yogaśāstra, dvitīya prakāśa, śloka 48.</p>
  <lg>
    <l><lb n="10"/>ādeyaḥ subhagaḥ saumyas tyāgī bhogī yaśonidhiḥ |</l>
    <l><lb n="11"/>bhavaty abhayadānena, ciraṃjīvī nirāmayaḥ || 13 ||</l>
  </lg>
  <p><lb n="12"/>mahābhārata, śāṃtiparva, a॰ 33, ślo॰ 10.</p>
  <lg>
    <l><lb n="17"/>abhayaṃ sarvabhūtebhyo, dattvā yaś carate muniḥ |</l>
    <l><lb n="18"/>na tasya sarvabhūtebhyo, bhayam utpadyate kvacit || 14 ||</l>
  </lg>
  <p><lb n="19"/>mahābhārata, śāntiparva, a॰ 190, śloka 4.</p>
  <pb facs="64" n="27"/>
  <lg corresp="#VP65.32 #Is4.32">
    <l><lb n="3"/>abhayaṃ sarvasattvebhyo, yo dadāti dayāparaḥ |</l>
    <l><lb n="4"/>tasya dehād vimuktasya, bhayaṃ nāsti kutaścana || 15 ||</l>
  </lg>
  <p><lb n="5"/>mārkaṇḍa purāṇa, a॰ 18, śloka 8.</p>
