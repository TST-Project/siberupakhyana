<text corresp="#Dhṭ" xml:lang="sa"><body>
<pb facs="249" n="248"/>
  <p><lb n="10"/>(tathācoktaṃ)</p>
  <lg corresp="#VP65.28 #Is4.30">
    <l><lb n="11"/>neha bhūyas tayo dharma, s tasmād anyo sti bhūtale,</l>
    <l><lb n="12"/>prāṇināṃ bhayabhītānā, m abhayaṃ yat pradīyate. 51</l>
  </lg>
  <lg corresp="#VP65.30 #Is4.33">
    <l><pb facs="250" n="249"/><lb n="1"/>hema dhenudharā dīnāṃ, dātāraḥ sulabhā bhuvi,</l>
    <l><lb n="2"/>durlabhaḥ puruṣo loke, yaḥ prāṇiṣv abhayapradaḥ 52</l>
  </lg>
  <lg corresp="#VP65.31 #Is4.34">
    <l><lb n="3"/>mahatā m api danānāṃ, kāḷena kṣīyate phaḷaṃ,</l>
    <l><lb n="4"/>bhītābhaya pradānasya, kṣaya eva na vidyate. 53</l>
  </lg>
  <lg corresp="#VP65.33 #Is4.35">
    <l><lb n="5"/>datta m iṣṭaṃ tapa s taptaṃ, tīrthasevā tathā śrutaṃ,</l>
    <l><lb n="6"/>sarvā ṇyabhayadānasya, kaḷāṃ nārhaṃti ṣoḍaśīṃ. 54</l>
  </lg>
  <lg corresp="#VP65.27 #Is4.3 #Mbh131.5ter">
    <l><lb n="7"/>ekataḥ kratavaḥ sarve, samagrā varadakṣiṇāḥ</l>
    <l><lb n="8"/>ekato bhayabhītasya, prāṇinaḥ prāṇarakṣaṇaṃ. 55</l>
    </lg>
  <lg corresp="#VP65.44 #Is4.46">
    <l><lb n="9"/>sarve vedāna tat kuryuḥ, sarve yajñā yathoditāḥ</l>
    <l><lb n="10"/>sarve tīrthābhiṣekā ś ca, yat_ kuryāt_ prāṇināṃ dayā. 56</l>
  </lg>
</body>
