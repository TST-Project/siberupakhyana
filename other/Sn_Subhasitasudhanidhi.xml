<text corresp="#Sn" xml:lang="sa"><body>
  <pb n="153" facs="90"/>
  <head><lb n="23"/>|| abhayadānapaddhatiḥ || 120 ||</head>
    <lg corresp="#VP65.27 #Is4.3">
      <l><lb n="24"/>ekataḥ kratavaḥ sarve samagravaradakṣiṇāḥ |</l>
      <l><lb n="25"/>ekato bhayabhītasya prāṇinaḥ prāṇarakṣaṇam || 1 ||</l>
  </lg>
  <lg>
    <l><lb n="26"/>baddhañjalipuṭaṃ dīnaṃ yācantaṃ śaraṇāgatam |</l>
    <l><lb n="27"/>na hanyād ānṛśaṃsyārtham api śatruṃ parantapa || 2 ||</l>
  </lg>
  <lg>
    <l><pb n="154" facs="91"/><lb n="1"/>ārtho vā yadi vā trastaḥ pareṣaṃ śaraṇāgataḥ |</l>
    <l><lb n="2"/>ariḥ prāṇān parityajya rakṣitavyaḥ kṛtātmanā || 3 ||</l>
  </lg>
  <lg>
    <l><lb n="3"/>vinaṣṭaḥ paśyatas tasya rakṣaṇe śaraṇāgataḥ |</l>
    <l><lb n="4"/>ādāya sukṛtaṃ tasya sarvaṃ gacched arakṣitaḥ || 4 ||</l>
  </lg>
  <lg>
    <l><lb n="5"/>vibhīṣaṇo vā sugrīvo yadi vā rāvaṇaḥ svayam |</l>
    <l><lb n="6"/>ānayainaṃ naraśreṣṭha dattam asyābhayaṃ mayā || 5 ||</l>
  </lg>
  <lg>
    <l><lb n="7"/>amitram api cec cainaṃ śaraṇaiṣiṇam āgatam |</l>
    <l><lb n="8"/>vyasane yo 'nugṛhṇāti sa vai puruṣa ucyate || 6 ||</l>
  </lg>
  <lg>
    <l><lb n="9"/>śrūyate ca kapotena śatruḥ śaraṇam āgataḥ |</l>
    <l><lb n="10"/>arcitaś ca yathānyāyaṃ svaiś ca māṃsair bhojyata || 7 ||</l>
  </lg>
  <lg>
    <l><lb n="11"/>sakṛd eva prapannāya tavāsmīti ca yācate |</l>
    <l><lb n="12"/>abhayaṃ sarvabhūtebhyo dadāmy etad_ vrataṃ mama || 8 ||</l>
  </lg>
  <lg>
    <l><lb n="13"/>nṛgaprabhṛtayo rājan_ rājānaḥ śaraṇāgatāḥ |</l>
    <l><lb n="14"/>parivārya mahātmānaḥ saṃsiddhiṃ paramāṃ gatāḥ || 9 ||</l>
  </lg>
  <lg corresp="#VP65.31">
    <l><lb n="15"/>sarveṣām eva yajñānāṃ kṣīyate kālataḥ phalam |</l>
    <l><lb n="16"/>bhītābhayapradānasya kṣaya eva na vidyate || 10 ||</l>
  </lg>
  <lg corresp="#VP65.33">
    <l><lb n="17"/>dattam iṣṭaṃ tapaḥ satyaṃ tīrthasevā śrutaṃ tathā |</l>
    <l><lb n="18"/>sarvāṇy abhayadānasya kalāṃ nārhanti ṣoḍaśīm || 11 ||</l>
  </lg>
  <lg corresp="#VP65.34">
    <l><lb n="19"/>catuḥsāgaraparyantāṃ yo dadyāt pṛthivīm imām |</l>
    <l><lb n="20"/>abhayaṃ yas tu bhūtebhyas tayor abhayado 'dhikaḥ || 12 ||</l>
  </lg>
</body></text></TEI>
